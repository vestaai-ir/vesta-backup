<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_vesta_backup" model="ir.cron">
        <field name="name">Vesta Backup: run scheduled and queued backups</field>
        <field name="model_id" ref="model_vesta_backup_config"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_backups()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
